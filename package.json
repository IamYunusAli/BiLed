{
  "name": "daps-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant project tracker: organizations, projects and tasks with ETB budgets",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "predev": "npm run build:client",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/db-start.ps1",
    "migrate": "node-pg-migrate -m migrations",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:redo": "npm run migrate -- redo",
    "migrate:create": "npm run migrate -- create -j ts",
    "check:migrations": "node --env-file-if-exists=.env.test --import tsx scripts/check-migrations.ts",
    "seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "reset:demo-passwords": "node --env-file-if-exists=.env --import tsx scripts/reset-demo-passwords.ts",
    "demo": "node --import tsx scripts/demo-scenario.ts",
    "verify:data": "node --env-file-if-exists=.env --import tsx scripts/verify-data.ts",
    "test": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 \"test/**/*.test.ts\" \"test/**/*.test.tsx\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
